{
  "name": "sip-chatbot-server",
  "version": "1.0.0",
  "description": "",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f db",
    "db:migrate": "ts-node src/db/migrate.ts",
    "db:check": "ts-node src/db/check.ts",
    "db:ingest:exams": "ts-node src/db/ingestExams.ts",
    "db:ingest:kalendar": "ts-node src/db/ingestCalendar.ts",
    "db:ingest:raspored-casova": "ts-node src/db/ingestSchedules.ts",
    "db:ingest:tekst": "ts-node src/db/ingestTextual.ts",
    "db:embed": "ts-node src/db/embedChunks.ts",
    "db:ingest": "npm run db:ingest:exams && npm run db:ingest:kalendar && npm run db:ingest:raspored-casova && npm run db:ingest:tekst",
    "data:report": "ts-node --transpile-only src/preprocessing/dataReport.ts",
    "test:preprocessing": "ts-node --transpile-only src/preprocessing/preprocessing.test.ts",
    "test:conversation": "ts-node --transpile-only src/services/conversation.test.ts",
    "update:exams": "ts-node src/scraper/scrapeExamSchedule.ts",
    "update:kalendar": "ts-node src/scraper/scrapeActivityCalendar.ts",
    "update:raspored-casova": "ts-node src/scraper/scrapeClassSchedules.ts",
    "update:konkursi": "ts-node src/scraper/scrapeOpportunities.ts",
    "update:dokumentacija": "ts-node src/scraper/scrapeDocumentation.ts",
    "scheduler": "ts-node src/index.ts",
    "scheduler:once": "ts-node src/index.ts --once",
    "start": "node dist/server.js",
    "dev": "nodemon --exec ts-node --transpile-only src/server.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@napi-rs/canvas": "^1.0.2",
    "axios": "^1.18.1",
    "cheerio": "^1.2.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "js-tiktoken": "^1.0.21",
    "node-cron": "^4.6.0",
    "nodemon": "^3.1.14",
    "openai": "^6.48.0",
    "pdf-parse": "^2.4.5",
    "pdfjs-dist": "^6.1.200",
    "pg": "^8.22.0",
    "socket.io": "^4.8.3",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.1.1",
    "@types/pg": "^8.20.4",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
}
